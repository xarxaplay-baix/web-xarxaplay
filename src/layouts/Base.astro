---
// Tipografies allotjades a la mateixa web (més ràpid i sense enviar dades a Google Fonts, RGPD)
import "@fontsource/saira/latin-600.css";
import "@fontsource/saira/latin-800.css";
import "@fontsource/saira/latin-700-italic.css";
import "@fontsource/saira/latin-800-italic.css";
import "@fontsource/barlow/latin-400.css";
import "@fontsource/barlow/latin-500.css";
import "@fontsource/barlow/latin-600.css";
import "@fontsource/barlow/latin-700.css";
import sairaH from "@fontsource/saira/files/saira-latin-800-italic.woff2?url";
import barlowR from "@fontsource/barlow/files/barlow-latin-400-normal.woff2?url";
import "../styles/global.css";
import { site } from "../site.config";
import { abs, business, website, breadcrumbList } from "../data/schema";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Lang } from "../data/routes";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string; // ruta d'aquesta pàgina, p. ex. "/" o "/es/"
  alternates: { ca: string; es: string };
  ogImage?: string; // ruta d'una imatge 1200×630
  ogType?: "website" | "article";
  pageType?: string; // tipus schema.org de la pàgina (WebPage, CollectionPage, AboutPage...)
  crumbs?: { name: string; url: string }[]; // ruta de navegació (sense la pàgina d'inici)
  schema?: Record<string, unknown>[]; // nodes JSON-LD addicionals
}
const { lang, title, description, path, alternates, ogImage = "/img/og-xarxaplay.jpg", ogType = "website", pageType = "WebPage", crumbs = [], schema = [] } = Astro.props;
const url = abs(path);
const homeName = lang === "es" ? "Inicio" : "Inici";
const fullCrumbs = crumbs.length ? [{ name: homeName, url: lang === "es" ? "/es/" : "/" }, ...crumbs] : [];

const graph: Record<string, unknown>[] = [
  business(lang),
  website(),
  {
    "@type": pageType,
    "@id": url + "#webpage",
    url,
    name: title,
    description,
    inLanguage: lang,
    isPartOf: { "@id": abs("/#website") },
    about: { "@id": abs("/#xarxaplay") },
    primaryImageOfPage: { "@type": "ImageObject", url: abs(ogImage) },
    ...(fullCrumbs.length ? { breadcrumb: { "@id": url + "#breadcrumb" } } : {}),
  },
  ...(fullCrumbs.length ? [breadcrumbList(path, fullCrumbs)] : []),
  ...schema,
];
const ld = { "@context": "https://schema.org", "@graph": graph };
---
<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{site.indexable
  ? <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  : <meta name="robots" content="noindex, nofollow">}
<link rel="canonical" href={url}>
<link rel="alternate" hreflang="ca" href={abs(alternates.ca)}>
<link rel="alternate" hreflang="es" href={abs(alternates.es)}>
<link rel="alternate" hreflang="x-default" href={abs(alternates.ca)}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/img/icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#4C7320">
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="XarxaPlay">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={abs(ogImage)}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content={lang === "es" ? "es_ES" : "ca_ES"}>
<meta property="og:locale:alternate" content={lang === "es" ? "ca_ES" : "es_ES"}>
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href={sairaH} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={barlowR} as="font" type="font/woff2" crossorigin>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<!-- Google tag (gtag.js) amb Consent Mode v2: tot denegat fins que el visitant accepti -->
<script is:inline define:vars={{ gaId: site.gaId }}>
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
window.gtag = gtag;
gtag('consent', 'default', {ad_storage:'denied', ad_user_data:'denied', ad_personalization:'denied', analytics_storage:'denied', wait_for_update: 500});
try { var c = localStorage.getItem('xp_consent'); if (c === 'grant') gtag('consent', 'update', {analytics_storage:'granted'}); } catch (e) {}
gtag('js', new Date());
gtag('config', gaId);
</script>
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
</head>
<body>
<a class="skip" href="#top">{lang === "es" ? "Saltar al contenido" : "Salta al contingut"}</a>
<Header lang={lang} alternates={alternates} />
{fullCrumbs.length > 0 && (
  <nav class="crumbs" aria-label={lang === "es" ? "Ruta de navegación" : "Ruta de navegació"}>
    <ol class="wrap">
      {fullCrumbs.map((c, i) => i < fullCrumbs.length - 1
        ? <li><a href={c.url} set:html={c.name} /></li>
        : <li aria-current="page" set:html={c.name} />)}
    </ol>
  </nav>
)}
<main id="top">
<slot />
</main>
<Footer lang={lang} />
<script is:inline src="/site.js" defer></script>
</body>
</html>
