---
import Base from "../layouts/Base.astro";
import { homeFaq } from "../data/faq";
import { faqPage } from "../data/schema";
import Home from "../components/Home.astro";
---
<Base
  lang="ca"
  path="/"
  alternates={{ ca: "/", es: "/es/" }}
  schema={[faqPage("/", homeFaq("ca"), "ca")]}
  title="Pàdel, pickleball i tennis a Sant Boi de Llobregat | XarxaPlay"
  description="11 pistes de pàdel, 4 de pickleball i 1 de tennis a Sant Boi de Llobregat (Baix Llobregat). Reserva online i prova gratis l'escola de pàdel."
>
  <Home lang="ca" />
</Base>
