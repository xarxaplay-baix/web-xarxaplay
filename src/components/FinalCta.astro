---
import { texts } from "../i18n/t";
import { routes, type Lang } from "../data/routes";
import { site } from "../site.config";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = texts(lang);
---
<section class="final">
  <div class="wrap">
    <h2><Fragment set:html={t["fin_h2"]} /></h2>
    <div class="cta-row" style="margin:0">
      <a class="btn btn-green" href={site.playtomic}><Fragment set:html={t["cta_book"]} /></a>
      <a class="btn btn-ghost" href={`${routes.escola[lang]}#prova`}><Fragment set:html={t["cta_trial"]} /></a>
    </div>
  </div>
</section>
