<div class="art-hero"><svg class="ill wide" style="background:#4C7320" viewBox="0 0 600 340" preserveAspectRatio="xMidYMid meet" role="img" aria-hidden="true"><rect width="600" height="340" fill="#4C7320"/><path d="M300 270 C220 210 170 160 170 115 C170 80 198 55 230 55 C258 55 280 72 300 98 C320 72 342 55 370 55 C402 55 430 80 430 115 C430 160 380 210 300 270Z" fill="#E6E200"/><path d="M60 170 L200 170 L230 120 L265 220 L300 140 L325 170 L540 170" stroke="#fff" stroke-width="10" fill="none" stroke-linejoin="round"/></svg></div>
