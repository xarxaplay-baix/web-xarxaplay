<div class="art-hero"><svg class="ill wide" style="background:#2D5C8C" viewBox="0 0 600 340" preserveAspectRatio="xMidYMid meet" role="img" aria-hidden="true"><rect width="600" height="340" fill="#2D5C8C"/><rect x="150" y="60" width="170" height="190" rx="70" fill="#E6E200" transform="rotate(-18 235 155)"/><rect x="250" y="225" width="34" height="95" rx="12" fill="#121410" transform="rotate(-18 235 155)"/><circle cx="420" cy="190" r="58" fill="#fff"/><g fill="#2D5C8C"><circle cx="400" cy="170" r="9"/><circle cx="440" cy="170" r="9"/><circle cx="420" cy="205" r="9"/><circle cx="388" cy="205" r="7"/><circle cx="452" cy="205" r="7"/></g></svg></div>
