<div class="art-hero"><svg class="ill wide" style="background:#1F3110" viewBox="0 0 600 340" preserveAspectRatio="xMidYMid meet" role="img" aria-hidden="true"><rect width="600" height="340" fill="#1F3110"/><g fill="#E6E200"><circle cx="200" cy="110" r="34"/><circle cx="400" cy="110" r="34"/><circle cx="200" cy="240" r="34"/></g><circle cx="400" cy="240" r="34" fill="#fff"/><path d="M250 92 C290 70 320 70 352 92" stroke="#fff" stroke-width="8" fill="none"/><path d="M352 258 C320 282 290 282 250 258" stroke="#fff" stroke-width="8" fill="none"/><path d="M342 80 L356 95 L336 102 M258 270 L244 255 L264 248" stroke="#fff" stroke-width="8" fill="none"/></svg></div>
