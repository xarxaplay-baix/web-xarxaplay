---
// Pàgina d'inici (CA i ES). Els textos són a src/i18n/ca.json i src/i18n/es.json
import ca from "../i18n/ca.json";
import es from "../i18n/es.json";
import SportDetail from "./SportDetail.astro";
interface Props { lang: "ca" | "es" }
const { lang } = Astro.props;
const t: Record<string, string> = lang === "es" ? { ...ca, ...es } : ca;
---
<div class="topbar">
  <div class="wrap">
    <span><a href="tel:+34611755275">+34 611 75 52 75</a><span class="hide-sm"> · C/ Baldiri Aleu 1-7, Sant Boi de Llobregat</span></span>
    <nav class="lang" aria-label={t.lang_label}><a href="/" hreflang="ca" lang="ca" aria-current={lang === "ca" ? "page" : undefined}>CA</a><a href="/es/" hreflang="es" lang="es" aria-current={lang === "es" ? "page" : undefined}>ES</a></nav>
  </div>
</div>

<header class="site">
  <div class="wrap">
    <a class="logo" href="#inici" aria-label="XarxaPlay, inici"><img src="/img/logo-xarxaplay.png" alt="XarxaPlay Baix Llobregat" width="420" height="233"></a>
    <nav class="main" aria-label="Principal">
      <a href="#padel"><Fragment set:html={t["nav1"]} /></a>
      <a href="#pickleball"><Fragment set:html={t["nav2"]} /></a>
      <a href="#tennis"><Fragment set:html={t["nav3"]} /></a>
      <a href="#escola"><Fragment set:html={t["nav4"]} /></a>
      <a href="#tornejos"><Fragment set:html={t["nav5"]} /></a>
      <a href="#serveis"><Fragment set:html={t["nav6"]} /></a>
      <a href="#blog"><Fragment set:html={t["nav8"]} /></a>
      <a href="#contacte"><Fragment set:html={t["nav7"]} /></a>
    </nav>
    <a class="btn btn-green" href="https://playtomic.com/clubs/new-complex-esportiu-baldiri-aleu"><Fragment set:html={t["cta_book"]} /></a>
    <button class="menu-btn" type="button" id="menu-btn" aria-expanded="false" aria-controls="mobile-nav"><Fragment set:html={t["menu"]} /></button>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mòbil">
    <a href="#padel"><Fragment set:html={t["nav1"]} /></a>
    <a href="#pickleball"><Fragment set:html={t["nav2"]} /></a>
    <a href="#tennis"><Fragment set:html={t["nav3"]} /></a>
    <a href="#escola"><Fragment set:html={t["nav4"]} /></a>
    <a href="#tornejos"><Fragment set:html={t["nav5"]} /></a>
    <a href="#serveis"><Fragment set:html={t["nav6"]} /></a>
    <a href="#blog"><Fragment set:html={t["nav8"]} /></a>
      <a href="#contacte"><Fragment set:html={t["nav7"]} /></a>
  </nav>
</header>

<main id="top">
  <section class="slider" id="inici" aria-roledescription="carrusel" aria-label="Destacats">
<div class="slide is-active" role="group" aria-roledescription="diapositiva" aria-label="1 de 4">
<img class="slide-art" src="/img/padel-pistes-sant-boi-1600.webp" srcset="/img/padel-pistes-sant-boi-800.webp 800w, /img/padel-pistes-sant-boi-1600.webp 1600w" sizes="100vw" width="1600" height="900" fetchpriority="high" decoding="async" alt={t["img_slide_padel"]}>
<div class="slide-inner wrap"><div class="slide-copy">
<p class="eyebrow"><Fragment set:html={t["sl_padel_e"]} /></p>
<h1 class="slide-title"><Fragment set:html={t["sl_padel_t"]} /></h1>
<p class="slide-text"><Fragment set:html={t["sl_padel_p"]} /></p>
<div class="cta-row"><a class="btn btn-ball" href="https://playtomic.com/clubs/new-complex-esportiu-baldiri-aleu"><Fragment set:html={t["cta_book"]} /></a><a class="btn btn-ghost light" href="#escola"><Fragment set:html={t["cta_trial"]} /></a></div></div></div>
</div>
<div class="slide" role="group" aria-roledescription="diapositiva" aria-label="2 de 4" aria-hidden="true" inert>
<img class="slide-art" src="/img/pickleball-pistes-sant-boi-1600.webp" srcset="/img/pickleball-pistes-sant-boi-800.webp 800w, /img/pickleball-pistes-sant-boi-1600.webp 1600w" sizes="100vw" width="1600" height="900" loading="lazy" decoding="async" alt={t["img_slide_pick"]}>
<div class="slide-inner wrap"><div class="slide-copy">
<p class="eyebrow"><Fragment set:html={t["sl_pickleball_e"]} /></p>
<h2 class="slide-title"><Fragment set:html={t["sl_pickleball_t"]} /></h2>
<p class="slide-text"><Fragment set:html={t["sl_pickleball_p"]} /></p>
<div class="cta-row"><a class="btn btn-ball" href="https://playtomic.com/clubs/new-complex-esportiu-baldiri-aleu"><Fragment set:html={t["cta_book"]} /></a><a class="btn btn-ghost light" href="#escola"><Fragment set:html={t["cta_trial"]} /></a></div></div></div>
</div>
<div class="slide" role="group" aria-roledescription="diapositiva" aria-label="3 de 4" aria-hidden="true" inert>
<img class="slide-art" src="/img/tennis-pista-sant-boi-1600.webp" srcset="/img/tennis-pista-sant-boi-800.webp 800w, /img/tennis-pista-sant-boi-1600.webp 1600w" sizes="100vw" width="1600" height="900" loading="lazy" decoding="async" alt={t["img_slide_ten"]}>
<div class="slide-inner wrap"><div class="slide-copy">
<p class="eyebrow"><Fragment set:html={t["sl_tennis_e"]} /></p>
<h2 class="slide-title"><Fragment set:html={t["sl_tennis_t"]} /></h2>
<p class="slide-text"><Fragment set:html={t["sl_tennis_p"]} /></p>
<div class="cta-row"><a class="btn btn-ball" href="https://playtomic.com/clubs/new-complex-esportiu-baldiri-aleu"><Fragment set:html={t["cta_book"]} /></a><a class="btn btn-ghost light" href="#escola"><Fragment set:html={t["cta_trial"]} /></a></div></div></div>
</div>
<div class="slide" role="group" aria-roledescription="diapositiva" aria-label="4 de 4" aria-hidden="true" inert>
<img class="slide-art" src="/img/padel-pistes-baix-llobregat-1600.webp" srcset="/img/padel-pistes-baix-llobregat-800.webp 800w, /img/padel-pistes-baix-llobregat-1600.webp 1600w" sizes="100vw" width="1600" height="900" loading="lazy" decoding="async" alt={t["img_slide_escola"]}>
<div class="slide-inner wrap"><div class="slide-copy">
<p class="eyebrow"><Fragment set:html={t["sl_escola_e"]} /></p>
<h2 class="slide-title"><Fragment set:html={t["sl_escola_t"]} /></h2>
<p class="slide-text"><Fragment set:html={t["sl_escola_p"]} /></p>
<div class="cta-row"><a class="btn btn-ball" href="#escola"><Fragment set:html={t["cta_trial"]} /></a><a class="btn btn-ghost light" href="https://playtomic.com/clubs/new-complex-esportiu-baldiri-aleu"><Fragment set:html={t["cta_book"]} /></a></div></div></div>
</div>
<div class="slider-ui wrap"><button type="button" class="sl-arrow" id="sl-prev" aria-label="Anterior">&#8592;</button><div class="sl-dots">
<button type="button" class="sl-dot" aria-label="Diapositiva 1" aria-current="true"></button>
<button type="button" class="sl-dot" aria-label="Diapositiva 2" aria-current="false"></button>
<button type="button" class="sl-dot" aria-label="Diapositiva 3" aria-current="false"></button>
<button type="button" class="sl-dot" aria-label="Diapositiva 4" aria-current="false"></button>
</div><button type="button" class="sl-arrow" id="sl-next" aria-label="Següent">&#8594;</button></div></section>

  <div class="stats" aria-label="XarxaPlay en xifres">
    <div class="wrap">
      <div class="stat"><b>11</b><small><Fragment set:html={t["st1"]} /></small></div>
      <div class="stat"><b>4</b><small><Fragment set:html={t["st2"]} /></small></div>
      <div class="stat"><b>1</b><small><Fragment set:html={t["st3"]} /></small></div>
      <div class="stat"><b>7</b><small><Fragment set:html={t["st4"]} /></small></div>
    </div>
  </div>

  <section class="block" id="esports">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow"><Fragment set:html={t["sp_eyebrow"]} /></p>
        <h2><Fragment set:html={t["sp_h2"]} /></h2>
        <p class="lead"><Fragment set:html={t["sp_lead"]} /></p>
      </div>
      <div class="sports">
        <article class="sport">
          <img class="sport-img" src="/img/padel-pistes-sant-boi-800.webp" width="800" height="500" loading="lazy" decoding="async" alt={t["img_padel"]}>
          <div class="body">
            <p class="count"><Fragment set:html={t["padel_count"]} /></p>
            <h3><Fragment set:html={t["padel_h3"]} /></h3>
            <p><Fragment set:html={t["padel_p"]} /></p>
          </div>
          <div class="actions">
            <a class="btn btn-green" href="https://playtomic.com/clubs/new-complex-esportiu-baldiri-aleu"><Fragment set:html={t["cta_book"]} /></a>
            <a class="btn btn-ghost" href="#padel"><Fragment set:html={t["more"]} /></a>
          </div>
        </article>
        <article class="sport">
          <img class="sport-img" src="/img/pickleball-pista-sant-boi-800.webp" width="800" height="500" loading="lazy" decoding="async" alt={t["img_pick"]}>
          <div class="body">
            <p class="count"><Fragment set:html={t["pick_count"]} /></p>
            <h3><Fragment set:html={t["pick_h3"]} /></h3>
            <p><Fragment set:html={t["pick_p"]} /></p>
          </div>
          <div class="actions">
            <a class="btn btn-green" href="https://playtomic.com/clubs/new-complex-esportiu-baldiri-aleu"><Fragment set:html={t["cta_book"]} /></a>
            <a class="btn btn-ghost" href="#pickleball"><Fragment set:html={t["more"]} /></a>
          </div>
        </article>
        <article class="sport">
          <img class="sport-img" src="/img/tennis-pista-aeria-sant-boi-800.webp" width="800" height="500" loading="lazy" decoding="async" alt={t["img_ten"]}>
          <div class="body">
            <p class="count"><Fragment set:html={t["ten_count"]} /></p>
            <h3><Fragment set:html={t["ten_h3"]} /></h3>
            <p><Fragment set:html={t["ten_p"]} /></p>
          </div>
          <div class="actions">
            <a class="btn btn-green" href="https://playtomic.com/clubs/new-complex-esportiu-baldiri-aleu"><Fragment set:html={t["cta_book"]} /></a>
            <a class="btn btn-ghost" href="#tennis"><Fragment set:html={t["more"]} /></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <SportDetail id="padel" prefix="d_padel" t={t} main="padel-joc-parella" gallery={["padel-remat", "padel-servei", "padel-jugador"]} secondHref="#escola" />
  <SportDetail id="pickleball" prefix="d_pick" t={t} main="pickleball-joc" gallery={["pickleball-volea", "pickleball-torneig", "pickleball-pistes"]} reverse secondHref="#que-es-pickleball" />
  <SportDetail id="tennis" prefix="d_ten" t={t} main="tennis-pista" gallery={["tennis-pista-aeria", "tennis-pista-complex", "tennis-pista-lateral"]} secondHref="#tornejos" />

  <section class="block school on-dark" id="escola">
    <div class="wrap">
      <div>
        <p class="eyebrow"><Fragment set:html={t["sc_eyebrow"]} /></p>
        <h2><Fragment set:html={t["sc_h2"]} /></h2>
        <p class="lead" style="margin-top:14px"><Fragment set:html={t["sc_lead"]} /></p>
        <ol class="steps">
          <li><div><b><Fragment set:html={t["s1b"]} /></b><span><Fragment set:html={t["s1"]} /></span></div></li>
          <li><div><b><Fragment set:html={t["s2b"]} /></b><span><Fragment set:html={t["s2"]} /></span></div></li>
          <li><div><b><Fragment set:html={t["s3b"]} /></b><span><Fragment set:html={t["s3"]} /></span></div></li>
        </ol>
      </div>
      <form class="trial" id="trial" novalidate>
        <h3><Fragment set:html={t["f_h3"]} /></h3>
        <div class="field"><label for="f-name"><Fragment set:html={t["f_name"]} /></label><input id="f-name" name="name" autocomplete="name" required></div>
        <div class="two">
          <div class="field"><label for="f-phone"><Fragment set:html={t["f_phone"]} /></label><input id="f-phone" name="phone" type="tel" autocomplete="tel" required></div>
          <div class="field"><label for="f-who"><Fragment set:html={t["f_who"]} /></label>
            <select id="f-who" name="who"><option><Fragment set:html={t["o_adult"]} /></option><option><Fragment set:html={t["o_kid"]} /></option></select></div>
        </div>
        <div class="two">
          <div class="field"><label for="f-level"><Fragment set:html={t["f_level"]} /></label>
            <select id="f-level" name="level"><option><Fragment set:html={t["l0"]} /></option><option><Fragment set:html={t["l1"]} /></option><option><Fragment set:html={t["l2"]} /></option><option><Fragment set:html={t["l3"]} /></option></select></div>
          <div class="field"><label for="f-time"><Fragment set:html={t["f_time"]} /></label>
            <select id="f-time" name="time"><option><Fragment set:html={t["t1"]} /></option><option><Fragment set:html={t["t2"]} /></option><option selected><Fragment set:html={t["t3"]} /></option><option><Fragment set:html={t["t4"]} /></option></select></div>
        </div>
        <label class="check" for="f-ok"><input id="f-ok" type="checkbox" required> <span><Fragment set:html={t["f_ok"]} /></span></label>
        <button class="btn btn-ball" type="submit"><Fragment set:html={t["f_send"]} /></button>
        <p class="ok" role="status"><Fragment set:html={t["f_okmsg"]} /></p>
        <p class="note"><Fragment set:html={t["f_note"]} /></p>
      </form>
    </div>
  </section>

  <section class="block" id="tornejos">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow"><Fragment set:html={t["ev_eyebrow"]} /></p>
        <h2><Fragment set:html={t["ev_h2"]} /></h2>
        <p class="lead"><Fragment set:html={t["ev_lead"]} /></p>
      </div>
      <div class="events">
        <article class="event"><span class="tag"><Fragment set:html={t["tag_w"]} /></span><h3><Fragment set:html={t["e1h"]} /></h3><p><Fragment set:html={t["e1p"]} /></p></article>
        <article class="event"><span class="tag"><Fragment set:html={t["tag_c"]} /></span><h3><Fragment set:html={t["e2h"]} /></h3><p><Fragment set:html={t["e2p"]} /></p></article>
        <article class="event pick"><span class="tag"><Fragment set:html={t["tag_c"]} /></span><h3><Fragment set:html={t["e3h"]} /></h3><p><Fragment set:html={t["e3p"]} /></p></article>
        <article class="event ten"><span class="tag"><Fragment set:html={t["tag_c"]} /></span><h3><Fragment set:html={t["e4h"]} /></h3><p><Fragment set:html={t["e4p"]} /></p></article>
      </div>
      <div class="cta-row"><a class="btn btn-green" href="https://www.instagram.com/xarxaplay/"><Fragment set:html={t["ev_cta"]} /></a></div>
    </div>
  </section>

  <section class="block" id="serveis" style="padding-top:0">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow"><Fragment set:html={t["sv_eyebrow"]} /></p>
        <h2><Fragment set:html={t["sv_h2"]} /></h2>
      </div>
      <div class="services">
        <div class="svc"><h3><Fragment set:html={t["v1h"]} /></h3><p><Fragment set:html={t["v1p"]} /></p></div>
        <div class="svc"><h3><Fragment set:html={t["v2h"]} /></h3><p><Fragment set:html={t["v2p"]} /></p></div>
        <div class="svc"><h3><Fragment set:html={t["v3h"]} /></h3><p><Fragment set:html={t["v3p"]} /></p></div>
        <div class="svc"><h3><Fragment set:html={t["v4h"]} /></h3><p><Fragment set:html={t["v4p"]} /></p></div>
        <div class="svc"><h3><Fragment set:html={t["v5h"]} /></h3><p><Fragment set:html={t["v5p"]} /></p></div>
        <div class="svc"><h3><Fragment set:html={t["v6h"]} /></h3><p><Fragment set:html={t["v6p"]} /></p></div>
      </div>
    </div>
  </section>

  <section class="block where" id="contacte">
    <div class="wrap">
      <div>
        <p class="eyebrow"><Fragment set:html={t["wh_eyebrow"]} /></p>
        <h2><Fragment set:html={t["wh_h2"]} /></h2>
        <p class="lead" style="margin-top:14px"><Fragment set:html={t["wh_lead"]} /></p>
        <ul class="towns">
          <li>Sant Boi de Llobregat</li><li>Cornellà</li><li>Sant Joan Despí</li><li>Viladecans</li><li>Gavà</li><li>El Prat</li><li>Sant Vicenç dels Horts</li><li>Santa Coloma de Cervelló</li>
        </ul>
        <div class="addr">
          <span>C/ Baldiri Aleu 1-7, 08830 Sant Boi de Llobregat</span>
          <a href="tel:+34611755275">+34 611 75 52 75</a>
          <a href="mailto:info@xarxaplay.es">info@xarxaplay.es</a>
        </div>
        <div class="cta-row"><a class="btn btn-green" href="https://playtomic.com/clubs/new-complex-esportiu-baldiri-aleu"><Fragment set:html={t["cta_book"]} /></a><a class="btn btn-ghost" href="https://www.google.com/maps/search/?api=1&amp;query=Carrer+Baldiri+Aleu+1+Sant+Boi+de+Llobregat"><Fragment set:html={t["howto"]} /></a></div>
      </div>
      <div class="map" role="img" aria-label="Mapa de situació"><div class="pin">XarxaPlay<small>CE Baldiri Aleu</small></div></div>
    </div>
  </section>

  <section class="block" id="blog" style="padding-top:0"><div class="wrap">
<div class="head"><p class="eyebrow"><Fragment set:html={t["bl_eyebrow"]} /></p><h2><Fragment set:html={t["bl_h2"]} /></h2>
<p class="lead"><Fragment set:html={t["bl_lead"]} /></p></div>
<div class="posts">
<article class="post"><a class="post-link" href="#beneficis-jugar-padel">
<div class="post-img"><svg class="ill" style="background:#4C7320" viewBox="0 0 600 340" preserveAspectRatio="xMidYMid slice" role="img" aria-hidden="true"><rect width="600" height="340" fill="#4C7320"/><path d="M300 270 C220 210 170 160 170 115 C170 80 198 55 230 55 C258 55 280 72 300 98 C320 72 342 55 370 55 C402 55 430 80 430 115 C430 160 380 210 300 270Z" fill="#E6E200"/><path d="M60 170 L200 170 L230 120 L265 220 L300 140 L325 170 L540 170" stroke="#fff" stroke-width="10" fill="none" stroke-linejoin="round"/></svg><span class="tagpill"><Fragment set:html={t["b_beneficis-jugar-padel_g"]} /></span></div>
<div class="post-body"><h3><Fragment set:html={t["b_beneficis-jugar-padel_t"]} /></h3><p><Fragment set:html={t["b_beneficis-jugar-padel_x"]} /></p>
<span class="post-more"><span><Fragment set:html={t["read_more"]} /></span> · 5 min</span></div></a></article>
<article class="post"><a class="post-link" href="#que-es-pickleball">
<div class="post-img"><svg class="ill" style="background:#2D5C8C" viewBox="0 0 600 340" preserveAspectRatio="xMidYMid slice" role="img" aria-hidden="true"><rect width="600" height="340" fill="#2D5C8C"/><rect x="150" y="60" width="170" height="190" rx="70" fill="#E6E200" transform="rotate(-18 235 155)"/><rect x="250" y="225" width="34" height="95" rx="12" fill="#121410" transform="rotate(-18 235 155)"/><circle cx="420" cy="190" r="58" fill="#fff"/><g fill="#2D5C8C"><circle cx="400" cy="170" r="9"/><circle cx="440" cy="170" r="9"/><circle cx="420" cy="205" r="9"/><circle cx="388" cy="205" r="7"/><circle cx="452" cy="205" r="7"/></g></svg><span class="tagpill"><Fragment set:html={t["b_que-es-pickleball_g"]} /></span></div>
<div class="post-body"><h3><Fragment set:html={t["b_que-es-pickleball_t"]} /></h3><p><Fragment set:html={t["b_que-es-pickleball_x"]} /></p>
<span class="post-more"><span><Fragment set:html={t["read_more"]} /></span> · 4 min</span></div></a></article>
<article class="post"><a class="post-link" href="#americana-padel-sant-boi">
<div class="post-img"><svg class="ill" style="background:#1F3110" viewBox="0 0 600 340" preserveAspectRatio="xMidYMid slice" role="img" aria-hidden="true"><rect width="600" height="340" fill="#1F3110"/><g fill="#E6E200"><circle cx="200" cy="110" r="34"/><circle cx="400" cy="110" r="34"/><circle cx="200" cy="240" r="34"/></g><circle cx="400" cy="240" r="34" fill="#fff"/><path d="M250 92 C290 70 320 70 352 92" stroke="#fff" stroke-width="8" fill="none"/><path d="M352 258 C320 282 290 282 250 258" stroke="#fff" stroke-width="8" fill="none"/><path d="M342 80 L356 95 L336 102 M258 270 L244 255 L264 248" stroke="#fff" stroke-width="8" fill="none"/></svg><span class="tagpill"><Fragment set:html={t["b_americana-padel-sant-boi_g"]} /></span></div>
<div class="post-body"><h3><Fragment set:html={t["b_americana-padel-sant-boi_t"]} /></h3><p><Fragment set:html={t["b_americana-padel-sant-boi_x"]} /></p>
<span class="post-more"><span><Fragment set:html={t["read_more"]} /></span> · 4 min</span></div></a></article>
<article class="post"><a class="post-link" href="#escola-padel-sant-boi">
<div class="post-img"><svg class="ill" style="background:#E6E200" viewBox="0 0 600 340" preserveAspectRatio="xMidYMid slice" role="img" aria-hidden="true"><rect width="600" height="340" fill="#E6E200"/><rect x="130" y="210" width="110" height="70" fill="#4C7320"/><rect x="245" y="150" width="110" height="130" fill="#2F4A16"/><rect x="360" y="85" width="110" height="195" fill="#121410"/><g font-family="Saira,Arial" font-weight="800" font-style="italic" font-size="40" fill="#fff" text-anchor="middle"><text x="185" y="260">1</text><text x="300" y="230">2</text><text x="415" y="200">3</text></g><circle cx="415" cy="50" r="22" fill="#fff" stroke="#121410" stroke-width="5"/></svg><span class="tagpill"><Fragment set:html={t["b_escola-padel-sant-boi_g"]} /></span></div>
<div class="post-body"><h3><Fragment set:html={t["b_escola-padel-sant-boi_t"]} /></h3><p><Fragment set:html={t["b_escola-padel-sant-boi_x"]} /></p>
