---
// Pàgina d'inici (CA i ES). Els textos són a src/i18n/ca.json i src/i18n/es.json
import TournamentCalendar from "./TournamentCalendar.astro";
import { texts } from "../i18n/t";
import { routes, postsFor, type Lang } from "../data/routes";
import { homeFaq } from "../data/faq";
import { site } from "../site.config";
import TrialForm from "./TrialForm.astro";
import PostCard from "./PostCard.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = texts(lang);
const r = (k: keyof typeof routes) => routes[k][lang];
---
  <section class="slider" id="inici" aria-roledescription="carrusel" aria-label="Destacats">
<div class="slide is-active" role="group" aria-roledescription="diapositiva" aria-label="1 de 4">
<img class="slide-art" src="/img/home-padel-joc-1000.webp" srcset="/img/home-padel-joc-800.webp 800w, /img/home-padel-joc-1000.webp 1000w" sizes="100vw" width="1600" height="900" fetchpriority="high" decoding="async" alt={t["img_slide_padel"]}>
<div class="slide-inner wrap"><div class="slide-copy">
<p class="eyebrow"><Fragment set:html={t["sl_padel_e"]} /></p>
<h1 class="slide-title"><Fragment set:html={t["sl_padel_t"]} /></h1>
<p class="slide-text"><Fragment set:html={t["sl_padel_p"]} /></p>
<div class="cta-row"><a class="btn btn-ball" href={site.playtomic}><Fragment set:html={t["cta_book"]} /></a><a class="btn btn-ghost light" href="#escola"><Fragment set:html={t["cta_trial"]} /></a></div></div></div>
</div>
<div class="slide" role="group" aria-roledescription="diapositiva" aria-label="2 de 4" aria-hidden="true" inert>
<img class="slide-art" src="/img/home-pickleball-joc-1600.webp" srcset="/img/home-pickleball-joc-800.webp 800w, /img/home-pickleball-joc-1600.webp 1600w" sizes="100vw" width="1600" height="900" loading="lazy" decoding="async" alt={t["img_slide_pick"]}>
<div class="slide-inner wrap"><div class="slide-copy">
<p class="eyebrow"><Fragment set:html={t["sl_pickleball_e"]} /></p>
<h2 class="slide-title"><Fragment set:html={t["sl_pickleball_t"]} /></h2>
<p class="slide-text"><Fragment set:html={t["sl_pickleball_p"]} /></p>
<div class="cta-row"><a class="btn btn-ball" href={site.playtomic}><Fragment set:html={t["cta_book"]} /></a><a class="btn btn-ghost light" href="#escola"><Fragment set:html={t["cta_trial"]} /></a></div></div></div>
</div>
<div class="slide" role="group" aria-roledescription="diapositiva" aria-label="3 de 4" aria-hidden="true" inert>
<img class="slide-art" src="/img/tennis-pista-sant-boi-1600.webp" srcset="/img/tennis-pista-sant-boi-800.webp 800w, /img/tennis-pista-sant-boi-1600.webp 1600w" sizes="100vw" width="1600" height="900" loading="lazy" decoding="async" alt={t["img_slide_ten"]}>
<div class="slide-inner wrap"><div class="slide-copy">
<p class="eyebrow"><Fragment set:html={t["sl_tennis_e"]} /></p>
<h2 class="slide-title"><Fragment set:html={t["sl_tennis_t"]} /></h2>
<p class="slide-text"><Fragment set:html={t["sl_tennis_p"]} /></p>
<div class="cta-row"><a class="btn btn-ball" href={site.playtomic}><Fragment set:html={t["cta_book"]} /></a><a class="btn btn-ghost light" href="#escola"><Fragment set:html={t["cta_trial"]} /></a></div></div></div>
</div>
<div class="slide" role="group" aria-roledescription="diapositiva" aria-label="4 de 4" aria-hidden="true" inert>
<img class="slide-art art-nen" src="/img/home-escola-nen-1600.webp" srcset="/img/home-escola-nen-800.webp 800w, /img/home-escola-nen-1600.webp 1600w" sizes="100vw" width="1600" height="900" loading="lazy" decoding="async" alt={t["img_slide_escola"]}>
<div class="slide-inner wrap"><div class="slide-copy">
<p class="eyebrow"><Fragment set:html={t["sl_escola_e"]} /></p>
<h2 class="slide-title"><Fragment set:html={t["sl_escola_t"]} /></h2>
<p class="slide-text"><Fragment set:html={t["sl_escola_p"]} /></p>
<div class="cta-row"><a class="btn btn-ball" href="#escola"><Fragment set:html={t["cta_trial"]} /></a><a class="btn btn-ghost light" href={site.playtomic}><Fragment set:html={t["cta_book"]} /></a></div></div></div>
</div>
<div class="slider-ui wrap"><button type="button" class="sl-arrow" id="sl-prev" aria-label="Anterior">&#8592;</button><div class="sl-dots">
<button type="button" class="sl-dot" aria-label="Diapositiva 1" aria-current="true"></button>
<button type="button" class="sl-dot" aria-label="Diapositiva 2" aria-current="false"></button>
<button type="button" class="sl-dot" aria-label="Diapositiva 3" aria-current="false"></button>
<button type="button" class="sl-dot" aria-label="Diapositiva 4" aria-current="false"></button>
</div><button type="button" class="sl-arrow" id="sl-next" aria-label="Següent">&#8594;</button></div></section>

  <div class="stats" aria-label="XarxaPlay en xifres">
    <div class="wrap">
      <div class="stat"><b>11</b><small><Fragment set:html={t["st1"]} /></small></div>
      <div class="stat"><b>4</b><small><Fragment set:html={t["st2"]} /></small></div>
      <div class="stat"><b>1</b><small><Fragment set:html={t["st3"]} /></small></div>
      <div class="stat"><b>7</b><small><Fragment set:html={t["st4"]} /></small></div>
    </div>
  </div>

  <section class="block" id="esports">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow"><Fragment set:html={t["sp_eyebrow"]} /></p>
        <h2><Fragment set:html={t["sp_h2"]} /></h2>
        <p class="lead"><Fragment set:html={t["sp_lead"]} /></p>
      </div>
      <div class="sports">
        <article class="sport">
          <img class="sport-img" src="/img/home-card-padel-800.webp" width="800" height="500" loading="lazy" decoding="async" alt={t["img_padel"]}>
          <div class="body">
            <p class="count"><Fragment set:html={t["padel_count"]} /></p>
            <h3><Fragment set:html={t["padel_h3"]} /></h3>
            <p><Fragment set:html={t["padel_p"]} /></p>
          </div>
          <div class="actions">
            <a class="btn btn-green" href={site.playtomic}><Fragment set:html={t["cta_book"]} /></a>
            <a class="btn btn-ghost" href={r("padel")}><Fragment set:html={t["more_padel"]} /></a>
          </div>
        </article>
        <article class="sport">
          <img class="sport-img" src="/img/home-card-pickleball-800.webp" width="800" height="500" loading="lazy" decoding="async" alt={t["img_pick"]}>
          <div class="body">
            <p class="count"><Fragment set:html={t["pick_count"]} /></p>
            <h3><Fragment set:html={t["pick_h3"]} /></h3>
            <p><Fragment set:html={t["pick_p"]} /></p>
          </div>
          <div class="actions">
            <a class="btn btn-green" href={site.playtomic}><Fragment set:html={t["cta_book"]} /></a>
            <a class="btn btn-ghost" href={r("pickleball")}><Fragment set:html={t["more_pick"]} /></a>
          </div>
        </article>
        <article class="sport">
          <img class="sport-img" src="/img/tennis-pista-aeria-sant-boi-800.webp" width="800" height="500" loading="lazy" decoding="async" alt={t["img_ten"]}>
          <div class="body">
            <p class="count"><Fragment set:html={t["ten_count"]} /></p>
            <h3><Fragment set:html={t["ten_h3"]} /></h3>
            <p><Fragment set:html={t["ten_p"]} /></p>
          </div>
          <div class="actions">
            <a class="btn btn-green" href={site.playtomic}><Fragment set:html={t["cta_book"]} /></a>
            <a class="btn btn-ghost" href={r("tennis")}><Fragment set:html={t["more_ten"]} /></a>
          </div>
        </article>
      </div>
    </div>
  </section>


  <section class="block school on-dark" id="escola">
    <div class="wrap">
      <div>
        <p class="eyebrow"><Fragment set:html={t["sc_eyebrow"]} /></p>
        <h2><Fragment set:html={t["sc_h2"]} /></h2>
        <p class="lead" style="margin-top:14px"><Fragment set:html={t["sc_lead"]} /></p>
        <ol class="steps">
          <li><div><b><Fragment set:html={t["s1b"]} /></b><span><Fragment set:html={t["s1"]} /></span></div></li>
          <li><div><b><Fragment set:html={t["s2b"]} /></b><span><Fragment set:html={t["s2"]} /></span></div></li>
          <li><div><b><Fragment set:html={t["s3b"]} /></b><span><Fragment set:html={t["s3"]} /></span></div></li>
        </ol>
      </div>
      <TrialForm lang={lang} />
    </div>
  </section>

  <section class="block" id="tornejos">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow"><Fragment set:html={t["ev_eyebrow"]} /></p>
        <h2><Fragment set:html={t["ev_h2"]} /></h2>
        <p class="lead"><Fragment set:html={t["ev_lead"]} /></p>
      </div>
      <TournamentCalendar lang={lang} />
      <h3 class="ev-sub"><Fragment set:html={t["ev_sub"]} /></h3>
      <div class="events">
        <article class="event"><span class="tag"><Fragment set:html={t["tag_w"]} /></span><h3><Fragment set:html={t["e1h"]} /></h3><p><Fragment set:html={t["e1p"]} /></p></article>
        <article class="event"><span class="tag"><Fragment set:html={t["tag_c"]} /></span><h3><Fragment set:html={t["e2h"]} /></h3><p><Fragment set:html={t["e2p"]} /></p></article>
        <article class="event pick"><span class="tag"><Fragment set:html={t["tag_c"]} /></span><h3><Fragment set:html={t["e3h"]} /></h3><p><Fragment set:html={t["e3p"]} /></p></article>
        <article class="event ten"><span class="tag"><Fragment set:html={t["tag_c"]} /></span><h3><Fragment set:html={t["e4h"]} /></h3><p><Fragment set:html={t["e4p"]} /></p></article>
      </div>
      <div class="cta-row"><a class="btn btn-ghost" href={site.instagram} rel="noopener"><Fragment set:html={t["ev_cta"]} /></a></div>
    </div>
  </section>

  <section class="block" id="serveis" style="padding-top:0">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow"><Fragment set:html={t["sv_eyebrow"]} /></p>
        <h2><Fragment set:html={t["sv_h2"]} /></h2>
      </div>
      <div class="services">
        <div class="svc"><h3><Fragment set:html={t["v1h"]} /></h3><p><Fragment set:html={t["v1p"]} /></p></div>
        <div class="svc"><h3><Fragment set:html={t["v2h"]} /></h3><p><Fragment set:html={t["v2p"]} /></p></div>
        <div class="svc"><h3><Fragment set:html={t["v3h"]} /></h3><p><Fragment set:html={t["v3p"]} /></p></div>
        <div class="svc"><h3><Fragment set:html={t["v4h"]} /></h3><p><Fragment set:html={t["v4p"]} /></p></div>
        <div class="svc"><h3><Fragment set:html={t["v5h"]} /></h3><p><Fragment set:html={t["v5p"]} /></p></div>
        <div class="svc"><h3><Fragment set:html={t["v6h"]} /></h3><p><Fragment set:html={t["v6p"]} /></p></div>
      </div>
    </div>
  </section>

  <section class="block where" id="contacte">
    <div class="wrap">
      <div>
        <p class="eyebrow"><Fragment set:html={t["wh_eyebrow"]} /></p>
        <h2><Fragment set:html={t["wh_h2"]} /></h2>
        <p class="lead" style="margin-top:14px"><Fragment set:html={t["wh_lead"]} /></p>
        <ul class="towns">
          <li>Sant Boi de Llobregat</li><li>Cornellà</li><li>Sant Joan Despí</li><li>Viladecans</li><li>Gavà</li><li>El Prat</li><li>Sant Vicenç dels Horts</li><li>Santa Coloma de Cervelló</li>
        </ul>
        <div class="addr">
          <span>C/ Baldiri Aleu 1-7, 08830 Sant Boi de Llobregat</span>
          <a href="tel:+34611755275">+34 611 75 52 75</a>
          <a href="tel:+34936302838">+34 936 30 28 38 <small class="tel-tag"><Fragment set:html={t["tel_fix"]} /></small></a>
          <a href="mailto:info@xarxaplay.es">info@xarxaplay.es</a>
        </div>
        <div class="cta-row"><a class="btn btn-green" href={site.playtomic}><Fragment set:html={t["cta_book"]} /></a><a class="btn btn-ghost" href="https://www.google.com/maps/dir/?api=1&amp;destination=XarxaPlay%2C+Carrer+Baldiri+Aleu+1-7%2C+08830+Sant+Boi+de+Llobregat" rel="noopener" target="_blank" data-ev="com_arribar"><Fragment set:html={t["howto"]} /></a></div>
      </div>
      <div class="map" id="map" data-src={`https://www.google.com/maps?q=XarxaPlay%2C+Carrer+Baldiri+Aleu+1-7%2C+08830+Sant+Boi+de+Llobregat&hl=${lang}&z=16&output=embed`} data-title={t["map_title"]}>
        <div class="map-ph">
          <div class="pin">XarxaPlay<small>C/ Baldiri Aleu 1-7 · Sant Boi</small></div>
          <button type="button" class="btn btn-green map-load"><Fragment set:html={t["map_btn"]} /></button>
          <p class="map-note"><Fragment set:html={t["map_note"]} /></p>
        </div>
      </div>
    </div>
  </section>

  <section class="block" id="blog" style="padding-top:0"><div class="wrap">
<div class="head"><p class="eyebrow"><Fragment set:html={t["bl_eyebrow"]} /></p><h2><Fragment set:html={t["bl_h2"]} /></h2>
<p class="lead"><Fragment set:html={t["bl_lead"]} /></p></div>
<div class="posts">
{postsFor(lang).map((p) => <PostCard post={p} t={t} />)}
</div>
<div class="cta-row"><a class="btn btn-ghost" href={r("blog")}><Fragment set:html={t["bl_all"]} /></a></div>
</div></section>
  <section class="block" id="faq">
    <div class="wrap">
      <div class="head"><p class="eyebrow"><Fragment set:html={t["fq_eyebrow"]} /></p><h2><Fragment set:html={t["fq_h2"]} /></h2></div>
      <div class="faq">
        {homeFaq(lang).map((f, i) => <details open={i === 0}><summary set:html={f.q} /><p set:html={f.a} /></details>)}
      </div>
    </div>
  </section>

  <section class="final">
    <div class="wrap">
      <h2><Fragment set:html={t["fin_h2"]} /></h2>
      <div class="cta-row" style="margin:0">
        <a class="btn btn-green" href={site.playtomic}><Fragment set:html={t["cta_book"]} /></a>
        <a class="btn btn-ghost" href="#escola"><Fragment set:html={t["cta_trial"]} /></a>
      </div>
    </div>
  </section>
