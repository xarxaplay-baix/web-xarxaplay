---
// Bloc de detall d'un esport (pàdel, pickleball, tennis). Textos a src/i18n/*.json amb el prefix indicat.
interface Props {
  id: string;            // àncora del menú: padel, pickleball, tennis
  prefix: string;        // prefix de les claus de text: d_padel, d_pick, d_ten
  t: Record<string, string>;
  main: string;          // foto principal (4:5)
  gallery: string[];     // 3 fotos quadrades
  reverse?: boolean;     // foto a l'esquerra
  dark?: boolean;
  secondHref: string;    // enllaç del segon botó
  h1?: string;           // si s'indica, el títol es mostra com a H1 (pàgina pròpia de l'esport)
}
const { id, prefix, t, main, gallery, reverse = false, dark = false, secondHref, h1 } = Astro.props;
import { site } from "../site.config";
const k = (s: string) => t[`${prefix}_${s}`] ?? "";
const features = [1, 2, 3, 4].map((n) => k(`f${n}`)).filter(Boolean);
---
<section class:list={["block", "sport-detail", { reverse, "on-dark": dark }]} id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="sd-text">
      <p class="eyebrow"><Fragment set:html={k("e")} /></p>
      {h1 ? <h1 id={`${id}-title`} class="sd-h1"><Fragment set:html={h1} /></h1> : <h2 id={`${id}-title`}><Fragment set:html={k("t")} /></h2>}
      <p class="lead"><Fragment set:html={k("p")} /></p>
      <ul class="sd-feats">
        {features.map((f) => <li><Fragment set:html={f} /></li>)}
      </ul>
      <div class="cta-row">
        <a class="btn btn-green" href={site.playtomic}><Fragment set:html={t["cta_book"]} /></a>
        <a class="btn btn-ghost" href={secondHref}><Fragment set:html={k("cta2")} /></a>
      </div>
    </div>
    <div class="sd-media">
      <img class="sd-main" src={`/img/${main}.webp`} srcset={`/img/${main}-600.webp 600w, /img/${main}.webp 1000w`} sizes="(max-width: 900px) 92vw, 560px" width="1000" height="1250" loading={h1 ? "eager" : "lazy"} decoding="async" alt={k("alt0")}>
      {gallery.map((g, i) => (
        <img class="sd-thumb" src={`/img/${g}.webp`} srcset={`/img/${g}-360.webp 360w, /img/${g}.webp 700w`} sizes="(max-width: 900px) 33vw, 260px" width="700" height="700" loading="lazy" decoding="async" alt={k(`alt${i + 1}`)}>
      ))}
    </div>
  </div>
</section>
